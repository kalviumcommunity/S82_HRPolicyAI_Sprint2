# ============================================================
# HRPolicyAI — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
#   cp .env.example .env   (macOS/Linux)
#   copy .env.example .env (Windows)
#
# ⚠️  NEVER commit the real .env file.
#     It is already listed in .gitignore.
# ============================================================

# Base URL of the OpenAI-compatible API endpoint.
# Default (OpenAI): https://api.openai.com/v1
# For Azure or other proxies, replace accordingly.
API_BASE_URL=https://api.openai.com/v1

# Your secret API key from the provider.
# Keep this private — do NOT share or commit it.
OPENAI_API_KEY=your-secret-api-key-here

# The chat completion model to use for RAG responses.
# Examples: gpt-4o | gpt-4o-mini | gpt-3.5-turbo
CHAT_MODEL=gpt-4o-mini

# The embedding model used to vectorise HR documents.
# Examples: text-embedding-3-small | text-embedding-3-large | text-embedding-ada-002
EMBEDDING_MODEL=text-embedding-3-small

# Batch embedding controls.
EMBEDDING_BATCH_SIZE=2
EMBEDDING_MAX_RETRIES=3
# Approximate price per 1,000 input tokens; update for your provider/model.
EMBEDDING_COST_PER_1K_TOKENS=0.00002

# Local Chroma vector database configuration.
# Relative paths are resolved from rag-app-starter/.
CHROMA_DB_PATH=.chroma
CHROMA_COLLECTION_NAME=hr_policy_chunks
